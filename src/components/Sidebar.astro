---
import { getTags } from "../utils/contentful/api";
import Etsy from "./svgs/Etsy.astro";
import Instagram from "./svgs/Instagram.astro";
import LinkedIn from "./svgs/LinkedIn.astro";

const collections = (await getTags()).map((collection) => ({
  ...collection,
  // convert to uppercase first letter
  name: collection.name.charAt(0).toUpperCase() + collection.name.slice(1),
}));

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCollectionPage = collections.some((c) => path === `/${c.id}`);

const linkClass =
  "block py-2 px-3 rounded-lg hover:bg-white/10 hover:text-secondary transition-colors duration-200";
const active = (href: string) => (path === href ? "bg-white/15" : "");
const current = (href: string) => (path === href ? "page" : undefined);
---

<div class="sticky top-0 sm:hidden z-10">
  <button
    data-drawer-target="sidebar-multi-level-sidebar"
    data-drawer-toggle="sidebar-multi-level-sidebar"
    aria-controls="sidebar-multi-level-sidebar"
    type="button"
    aria-label="Open menu"
    class="inline-flex items-center p-4 text-white w-full bg-main"
  >
    <svg
      class="w-6 h-6"
      aria-hidden="true"
      fill="currentColor"
      viewBox="0 0 20 20"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        clip-rule="evenodd"
        fill-rule="evenodd"
        d="M2 4.75A.75.75 0 012.75 4h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 4.75zm0 10.5a.75.75 0 01.75-.75h7.5a.75.75 0 010 1.5h-7.5a.75.75 0 01-.75-.75zM2 10a.75.75 0 01.75-.75h14.5a.75.75 0 010 1.5H2.75A.75.75 0 012 10z"
      ></path>
    </svg>
    <span class="pl-2 text-xl hover:text-secondary">k.l.b designs</span>
  </button>
</div>

<div
  id="sidebar-multi-level-sidebar"
  class="fixed left-0 top-0 z-40 w-64 h-screen transition-transform -translate-x-full sm:translate-x-0"
>
  <nav
    class="bg-main p-4 sm:p-8 whitespace-nowrap h-full flex flex-col font-light text-white"
  >
    <div class="shrink-0">
      <span class="block text-3xl hover:text-secondary">
        <a href="/">k.l.b designs</a>
      </span>
    </div>

    <!-- scrolls if taller than the viewport -->
    <ul class="list-none pt-4 pr-2 -mr-2 flex-1 min-h-0 overflow-y-auto overflow-x-hidden">
      <!-- Main navigation links -->
      <li>
        <a
          class={`${linkClass} ${active("/")}`}
          href="/"
          aria-current={current("/")}>Gallery</a
        >
      </li>
      <li class="pt-1">
        <a
          class={`${linkClass} ${active("/about")}`}
          href="/about"
          aria-current={current("/about")}>About</a
        >
      </li>
      <li class="pt-1">
        <a
          class={`${linkClass} ${active("/contact")}`}
          href="/contact"
          aria-current={current("/contact")}>Contact</a
        >
      </li>

      <!-- Separator line -->
      <li class="pt-4 pb-2" role="separator">
        <hr class="border-white/30" />
      </li>

      <!-- collections dropdown -->
      <li class="pt-1">
        <div class="group">
          <button
            id="collections-toggle"
            type="button"
            class="flex items-center justify-between w-full py-2 px-3 rounded-lg hover:bg-white/10 group-hover:text-secondary transition-colors duration-200"
            aria-controls="collections-dropdown"
            aria-expanded={isCollectionPage ? "true" : "false"}
          >
            <span class="align-self-start">Collections</span>
            <svg
              id="collections-dropdown-svg"
              class:list={[
                "w-3 h-3 align-self-end transition-transform duration-150 ease-in-out",
                { "rotate-180": isCollectionPage },
              ]}
              aria-hidden="true"
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 10 6"
            >
              <path
                class="group-hover:stroke-secondary"
                stroke="white"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="m1 1 4 4 4-4"></path>
            </svg>
          </button>
        </div>
        <ul
          id="collections-dropdown"
          class:list={["pl-5", { hidden: !isCollectionPage }]}
        >
          {
            collections.map((collection) => (
              <li class="pt-1">
                <a
                  href={`/${collection.id}`}
                  aria-current={current(`/${collection.id}`)}
                  class={`flex justify-between items-center rounded-md px-2 -mx-2 py-0.5 hover:text-secondary ${active(`/${collection.id}`)}`}
                >
                  <span>{collection.name}</span>
                  <span class="text-white/60 text-sm">
                    {collection.itemCount}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </li>
    </ul>

    <div class="mt-auto pt-4 shrink-0">
      <!-- social media links -->
      <ul class="list-none flex gap-2">
        <li>
          <a
            href="https://www.instagram.com/k.l.b_designs/?hl=en"
            aria-label="Instagram"
            target="_blank"
            rel="noopener noreferrer"
            data-outbound-destination="instagram"
            data-outbound-location="sidebar"
          >
            <Instagram
              classList="fill-white hover:fill-secondary"
              width={30}
              height={30}
            />
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/kirsty-baird-60b03123b/"
            aria-label="LinkedIn"
            target="_blank"
            rel="noopener noreferrer"
            data-outbound-destination="linkedin"
            data-outbound-location="sidebar"
          >
            <LinkedIn
              classList="fill-white hover:fill-secondary"
              width={30}
              height={30}
            />
          </a>
        </li>
        <li>
          <a
            href="https://www.etsy.com/uk/shop/KLBDesignsGoods"
            aria-label="Etsy shop"
            target="_blank"
            rel="noopener noreferrer"
            data-outbound-destination="etsy"
            data-outbound-location="sidebar"
          >
            <Etsy
              classList="fill-white hover:fill-secondary"
              width={30}
              height={30}
            />
          </a>
        </li>
      </ul>

      <!-- copyright -->
      <p class="mt-3 text-xs text-white/60">
        © 2024 - {new Date().getFullYear()} Kirsty Baird ·{" "}
        <a href="/privacy" class="hover:text-secondary hover:underline"
          >Privacy</a
        >
      </p>
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById("collections-toggle");
  const dropdown = document.getElementById("collections-dropdown");
  const chevron = document.getElementById("collections-dropdown-svg");

  toggle?.addEventListener("click", () => {
    if (!dropdown) return;
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    dropdown.classList.toggle("hidden", open);
    chevron?.classList.toggle("rotate-180", !open);
  });
</script>
