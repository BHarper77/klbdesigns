---
import Instagram from "./svgs/Instagram.astro";

const ETSY_URL = "https://www.etsy.com/uk/shop/KLBDesignsGoods";
const INSTAGRAM_POST_URL = "https://www.instagram.com/k.l.b_designs/p/Dbii0t9IKJR/";
---

<div class="sm:ml-64">
  <section class="mx-4 sm:mx-8 mt-6 rounded-2xl overflow-hidden border border-main/30 bg-gradient-to-br from-main/10 via-white to-transparent">
    <div class="p-6 sm:p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
      <div>
        <span class="text-xs font-medium text-main uppercase tracking-widest">Coming Soon</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-semibold text-secondary leading-tight mt-1 mb-2">
          Embroidery <span class="text-main">× k.l.b designs</span>
        </h2>
        <p class="text-sm text-gray-500 font-light max-w-sm leading-relaxed">
          Hand-stitched textile art — a new medium with the same attention to detail. Coming to the shop soon.
        </p>
      </div>
      <div class="shrink-0 flex items-center gap-3">
      <a
        href={INSTAGRAM_POST_URL}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Embroidery commission info on Instagram"
        title="Embroidery commission info on Instagram"
        class="inline-flex items-center justify-center w-12 h-12 rounded-xl border border-main/40 fill-main hover:bg-main/10 transition-colors duration-200"
      >
        <Instagram classList="" width={20} height={20} />
      </a>
      <a
        href={ETSY_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-main text-white text-sm font-medium px-5 py-3 rounded-xl hover:bg-main-dark transition-colors duration-200"
      >
        <svg class="w-4 h-4 shrink-0" fill="currentColor" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M 23.96875 5 C 18.71075 5.604 9.7705781 5.2995938 6.1425781 5.1835938 L 6.1425781 6.4355469 C 8.5425781 6.8895469 9.0886719 6.805125 9.1386719 8.203125 C 9.3116719 12.026125 9.2266719 20.465578 9.1386719 24.017578 C 9.1206719 25.354578 8.3745781 25.309047 6.1425781 25.748047 L 6.1425781 27 C 13.440578 26.767 18.449281 26.789 24.238281 27 C 24.312281 26.075 24.753594 22.379 24.933594 21 L 23.701172 21 C 22.309172 24.293 22.040594 25.416016 19.058594 25.416016 L 14.675781 25.416016 C 13.202781 25.416016 12.501953 24.813109 12.501953 23.537109 L 12.501953 16.712891 C 15.767953 16.712891 16.822266 16.810547 16.822266 16.810547 C 18.317266 16.833547 18.55 18.031 19 20 L 20 20 C 19.894 15.167 19.784 16.977 20 12 L 19 12 C 18.352 14.787 18.309656 15.117063 16.847656 15.164062 C 16.847656 15.164062 15.349953 15.311109 12.501953 15.287109 L 12.501953 7.2460938 C 12.501953 6.9390937 12.526297 6.7675781 13.029297 6.7675781 L 19.757812 6.7675781 C 21.465812 6.7675781 21.878531 8.954 22.394531 11 L 23.599609 11 C 23.643609 10.113 23.81975 6.632 23.96875 5 z"></path>
        </svg>
        Follow on Etsy
      </a>
      </div>
    </div>
  </section>
</div>
