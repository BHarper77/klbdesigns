---
const ETSY_URL = "https://www.etsy.com/uk/shop/KLBDesignsGoods";
---

<div class="sm:ml-64">
  <div class="bg-main text-white px-5 py-2.5 flex items-center justify-between gap-4 text-sm">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="text-base shrink-0">🧵</span>
      <span class="font-light truncate">
        Embroidery products <strong class="font-medium">coming soon</strong> — hand-stitched pieces made to order.
      </span>
    </div>
    <a
      href={ETSY_URL}
      target="_blank"
      rel="noopener noreferrer"
      class="shrink-0 bg-white text-main font-medium px-3 py-1 rounded-full text-xs hover:bg-gray-100 transition-colors duration-200"
    >
      Visit Etsy Shop →
    </a>
  </div>
</div>
