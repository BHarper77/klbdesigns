---
import { queryTags } from "../utils/contentful/api";
import { throwError } from "../utils/helpers";
import { contentfulImage, contentfulSrcset } from "../utils/contentful/image";
import Etsy from "./svgs/Etsy.astro";
import Instagram from "./svgs/Instagram.astro";
// PROTOTYPE — remove with src/components/prototype
import LightboxPrototype from "./prototype/LightboxPrototype.astro";

type Props = {
  tagId: string;
  tagName?: string;
};

const { tagId, tagName } = Astro.props;

const tags = await queryTags(`metadata.tags.sys.id[all]=${tagId}`);

const images = tags.items.map((item) => {
  // response returns alt and media metadata in different arrays
  // match via media ID
  const itemId = item.fields.media.sys.id;
  const asset =
    tags.includes.Asset.find((asset) => asset.sys.id === itemId) ??
    throwError(`Couldn't find corresponding asset for item ${itemId}`);

  const date = new Date(item.sys.createdAt);
  const day = date.toLocaleDateString("en-GB", {
    day: "numeric",
  });

  const monthYear = date.toLocaleDateString("en-GB", {
    year: "numeric",
    month: "long",
  });

  // add "nth" to end of day
  const nth = ((day: number) => {
    if (day > 3 && day < 21) return "th";

    switch (day % 10) {
      case 1:
        return "st";
      case 2:
        return "nd";
      case 3:
        return "rd";
      default:
        return "th";
    }
  })(parseFloat(day));

  return {
    id: item.sys.id,
    alt: item.fields.alt,
    // no entry has a title yet, fall back to alt text
    title: item.fields.title?.trim() || item.fields.alt.trim(),
    dimensions: item.fields.dimensions,
    year: item.fields.year,
    src: contentfulImage(asset.fields.file.url, {
      w: 800,
      max: asset.fields.file.details.image.width,
    }),
    srcset: contentfulSrcset(
      asset.fields.file.url,
      [400, 800, 1200],
      asset.fields.file.details.image.width,
    ),
    full: contentfulImage(asset.fields.file.url, {
      w: 1600,
      q: 80,
      max: asset.fields.file.details.image.width,
    }),
    height: asset.fields.file.details.image.height,
    width: asset.fields.file.details.image.width,
    instagramUrl: item.fields.instagramUrl,
    etsyUrl: item.fields.etsyUrl,
    friendlyDate: `${day}${nth} of ${monthYear}`,
  };
});

type Image = (typeof images)[number];

const columns = Array.from({ length: 3 }, () => ({
  height: 0,
  images: [] as Image[],
}));

for (const image of images) {
  // get column with lowest total height
  const targetColumn =
    columns.sort((a, b) => a.height - b.height)[0] ??
    throwError("Error getting target column");

  targetColumn.images.push(image);
  targetColumn.height += image.height;
}

const imageArrays = columns
  .map((column) => column.images)
  .sort((a, b) => b.length - a.length);

const firstId = imageArrays[0]?.[0]?.id;

const svgSize = 30;

/** Helper function for returning default Tailwind transition classes */
function transition<T extends string>(
  prop: T,
): `transition-${T} ease-in-out duration-200` {
  return `transition-${prop} ease-in-out duration-200`;
}
---

<style>
  /* can't add multiple custom transitions with tailwind */
  #overlay-container {
    transition:
			/* delay visibility so opacity can transition */
      visibility 0.3s,
      opacity 0.3s,
      blur 0.3s;
  }

  /* Lightbox content animation */
  #overlay-image-container {
    transition:
      transform 0.3s ease-out,
      opacity 0.3s ease-out;
    transform: scale(0.95);
    opacity: 0;
  }

  #overlay-container.open #overlay-image-container {
    transform: scale(1);
    opacity: 1;
  }

  /* Lightbox image loading state */
  #overlay-image {
    transition: opacity 0.2s ease-out;
  }

  #overlay-image-container.is-loading #overlay-image {
    opacity: 0;
  }

  #overlay-spinner {
    display: none;
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2rem;
    height: 2rem;
    margin: -1rem 0 0 -1rem;
    border: 3px solid rgba(255, 255, 255, 0.3);
    border-top-color: #fff;
    border-radius: 9999px;
    animation: lightbox-spin 0.8s linear infinite;
  }

  #overlay-image-container.is-loading #overlay-spinner {
    display: block;
  }

  @keyframes lightbox-spin {
    to {
      transform: rotate(360deg);
    }
  }

  /* Fix gallery layout - add margin to push content right of sidebar */
  @media (min-width: 640px) {
    #container,
    .gallery-header {
      margin-left: 16rem; /* 256px = sidebar width */
    }
  }

  /* When details panel is hidden, center the image and remove max-width constraint */
  #overlay-image-container.no-details {
    justify-content: center;
  }

  #overlay-image-container.no-details .image-section {
    max-width: none;
  }
</style>

<script>
  (() => {
    const overlayContainer = document.getElementById("overlay-container");

    if (!overlayContainer) {
      console.error("Error finding overlay container");
      return;
    }

    // Store validated container reference
    const container = overlayContainer;

    // Lightbox elements - use non-null assertion after validation
    const detailsPanel =
      overlayContainer.querySelector<HTMLDivElement>("#details-panel");
    const overlayImage =
      overlayContainer.querySelector<HTMLImageElement>("#overlay-image")!;
    const overlayTitle =
      overlayContainer.querySelector<HTMLElement>("#overlay-title")!;
    const overlayCategory =
      overlayContainer.querySelector<HTMLElement>("#overlay-category")!;
    const overlayDimensions = overlayContainer.querySelector<HTMLElement>(
      "#overlay-dimensions",
    )!;
    const overlayYear =
      overlayContainer.querySelector<HTMLElement>("#overlay-year")!;
    const metaDimensions =
      overlayContainer.querySelector<HTMLElement>("#meta-dimensions")!;
    const metaYear = overlayContainer.querySelector<HTMLElement>("#meta-year")!;
    const overlayEtsy =
      overlayContainer.querySelector<HTMLAnchorElement>("#overlay-etsy")!;
    const overlayInsta =
      overlayContainer.querySelector<HTMLAnchorElement>("#overlay-insta")!;
    const metadataContainer = overlayContainer.querySelector<HTMLElement>(
      "#metadata-container",
    )!;
    const socialLinksContainer = overlayContainer.querySelector<HTMLElement>(
      "#social-links-container",
    )!;
    const closeBtn =
      overlayContainer.querySelector<HTMLButtonElement>("#lightbox-close")!;
    const prevBtn =
      overlayContainer.querySelector<HTMLButtonElement>("#lightbox-prev")!;
    const nextBtn =
      overlayContainer.querySelector<HTMLButtonElement>("#lightbox-next")!;
    const counterCurrent =
      overlayContainer.querySelector<HTMLElement>("#counter-current")!;
    const counterTotal =
      overlayContainer.querySelector<HTMLElement>("#counter-total")!;

    // Validate all elements exist
    if (
      !detailsPanel ||
      !overlayImage ||
      !overlayTitle ||
      !overlayCategory ||
      !overlayDimensions ||
      !overlayYear ||
      !metaDimensions ||
      !metaYear ||
      !overlayEtsy ||
      !overlayInsta ||
      !metadataContainer ||
      !socialLinksContainer ||
      !closeBtn ||
      !prevBtn ||
      !nextBtn ||
      !counterCurrent ||
      !counterTotal
    ) {
      console.error("Error finding lightbox elements");
      return;
    }

    // Collect all gallery images with their data
    type ImageData = {
      src: string;
      title: string;
      dimensions: string;
      year: string;
      category: string;
      etsyUrl: string;
      instaUrl: string;
      alt: string;
    };

    const galleryImages: ImageData[] = [];
    let currentIndex = 0;
    let lastTrigger: HTMLElement | null = null;

    const items = document.querySelectorAll<HTMLButtonElement>(".gallery-item");

    items.forEach((item) => {
      const img = item.querySelector("img");
      galleryImages.push({
        src: item.dataset.full || img?.src || "",
        title: item.dataset.title || "",
        dimensions: item.dataset.dimensions || "",
        year: item.dataset.year || "",
        category: item.dataset.category || "",
        etsyUrl: item.dataset.etsyUrl || "",
        instaUrl: item.dataset.instaUrl || "",
        alt: img?.alt || "",
      });
    });

    function showImage(index: number) {
      if (index < 0 || index >= galleryImages.length) return;

      currentIndex = index;
      const image = galleryImages[index]!;

      // Update image; fade out until the new one has loaded
      const imageContainer = document.getElementById("overlay-image-container");
      const done = () => imageContainer?.classList.remove("is-loading");
      imageContainer?.classList.add("is-loading");
      overlayImage.onload = done;
      overlayImage.onerror = done;
      overlayImage.alt = image.alt;
      overlayImage.src = image.src;
      if (overlayImage.complete && overlayImage.naturalWidth > 0) done();

      // Preload the next image
      const next = galleryImages[(index + 1) % galleryImages.length];
      if (next) new Image().src = next.src;

      // Update counter
      counterCurrent.textContent = (index + 1).toString();
      counterTotal.textContent = galleryImages.length.toString();

      // hide details panel if nothing to show
      if (
        !image.title &&
        !image.dimensions &&
        !image.year &&
        !image.etsyUrl &&
        !image.instaUrl
      ) {
        if (detailsPanel) detailsPanel.style.display = "none";
        document
          .getElementById("overlay-image-container")
          ?.classList.add("no-details");
      } else {
        if (detailsPanel) detailsPanel.style.display = "flex";
        document
          .getElementById("overlay-image-container")
          ?.classList.remove("no-details");
      }

      // Update title and category
      overlayTitle.textContent = image.title || "Untitled";
      overlayCategory.textContent = image.category || "";

      if (image.dimensions) {
        overlayDimensions.textContent = image.dimensions;
        metaDimensions.style.display = "flex";
      } else {
        metaDimensions.style.display = "none";
      }

      if (image.year) {
        overlayYear.textContent = image.year;
        metaYear.style.display = "flex";
      } else {
        metaYear.style.display = "none";
      }

      // Hide metadata container if no metadata
      if (!image.dimensions && !image.year) {
        metadataContainer.style.display = "none";
      } else {
        metadataContainer.style.display = "block";
      }

      // Update social links
      if (image.etsyUrl) {
        overlayEtsy.href = image.etsyUrl;
        overlayEtsy.style.display = "block";
      } else {
        overlayEtsy.style.display = "none";
      }

      if (image.instaUrl) {
        overlayInsta.href = image.instaUrl;
        overlayInsta.style.display = "block";
      } else {
        overlayInsta.style.display = "none";
      }

      // Hide social links container if no links
      const socialLinksContainer = document.getElementById(
        "social-links-container",
      );
      if (socialLinksContainer) {
        if (!image.etsyUrl && !image.instaUrl) {
          socialLinksContainer.style.display = "none";
        } else {
          socialLinksContainer.style.display = "flex";
        }
      }
    }

    let unlockScrollTimeout: number | undefined;

    function openLightbox(index: number, trigger?: HTMLElement) {
      lastTrigger = trigger ?? null;
      clearTimeout(unlockScrollTimeout);
      showImage(index);
      container.style.visibility = "visible";
      container.style.opacity = "1";
      container.classList.add("open");
      // Reserve the space the scrollbar occupied so locking scroll doesn't
      // shift the layout
      const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
      if (scrollbarWidth > 0) {
        document.body.style.paddingRight = `${scrollbarWidth}px`;
      }
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    }

    function closeLightbox() {
      lastTrigger?.focus();
      lastTrigger = null;
      container.style.visibility = "hidden";
      container.style.opacity = "0";
      container.classList.remove("open");
      // Wait for the fade-out to finish before restoring the scrollbar,
      // otherwise the reflow is visible through the overlay
      clearTimeout(unlockScrollTimeout);
      unlockScrollTimeout = window.setTimeout(() => {
        document.body.style.overflow = "";
        document.body.style.paddingRight = "";
      }, 300);
    }

    function showPrev() {
      const newIndex =
        currentIndex > 0 ? currentIndex - 1 : galleryImages.length - 1;
      showImage(newIndex);
    }

    function showNext() {
      const newIndex =
        currentIndex < galleryImages.length - 1 ? currentIndex + 1 : 0;
      showImage(newIndex);
    }

    // Click handlers for gallery images
    items.forEach((item, index) => {
      item.addEventListener("click", () => openLightbox(index, item));
    });

    // Close button
    closeBtn.addEventListener("click", closeLightbox);

    // Navigation buttons
    prevBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      showPrev();
    });

    nextBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      showNext();
    });

    // Click outside to close
    container.addEventListener("click", (event) => {
      const imageContainer = document.getElementById("overlay-image-container");
      const isNavButton = (event.target as Element).closest(
        "#lightbox-prev, #lightbox-next, #lightbox-close",
      );

      if (!imageContainer?.contains(event.target as Node) && !isNavButton) {
        closeLightbox();
      }
    });

    // Swipe left/right to navigate
    let touchStartX = 0;
    let touchStartY = 0;
    container.addEventListener(
      "touchstart",
      (e) => {
        const t = e.changedTouches[0];
        if (!t) return;
        touchStartX = t.clientX;
        touchStartY = t.clientY;
      },
      { passive: true },
    );
    container.addEventListener(
      "touchend",
      (e) => {
        const t = e.changedTouches[0];
        if (!t) return;
        const dx = t.clientX - touchStartX;
        const dy = t.clientY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.5) {
          if (dx < 0) showNext();
          else showPrev();
        }
      },
      { passive: true },
    );

    // Keyboard navigation
    document.addEventListener("keydown", (event) => {
      if (container.style.visibility !== "visible") return;

      if (event.key === "Tab") {
        // keep focus inside the dialog
        const focusable = Array.from(
          container.querySelectorAll<HTMLElement>("button, a[href]"),
        ).filter((el) => el.getClientRects().length > 0);
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (!first || !last) return;
        const active = document.activeElement;
        if (!container.contains(active)) {
          event.preventDefault();
          first.focus();
        } else if (event.shiftKey && active === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
        return;
      }

      switch (event.key) {
        case "Escape":
          closeLightbox();
          break;
        case "ArrowLeft":
          showPrev();
          break;
        case "ArrowRight":
          showNext();
          break;
      }
    });
  })();
</script>

<!-- Gallery header -->
{
  tagName && (
    <div class="px-5 sm:px-12 pt-5 sm:pt-8 gallery-header">
      <h1 class="text-2xl sm:text-4xl text-secondary">
        {/* convert to first letter uppercase */}
        {tagName.charAt(0).toUpperCase() + tagName.slice(1)}
      </h1>
      <p class="text-gray-500 mt-1">
        {`${images.length} ${images.length === 1 ? "piece" : "pieces"}`}
      </p>
    </div>
  )
}

<!-- main gallery -->
<div
  id="container"
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 p-5 sm:px-12 sm:pt-5 gap-4"
>
  {
    imageArrays.map((images) => (
      <div>
        {images.map((image) => (
          <div class="block relative group hover:cursor-pointer mb-4 overflow-hidden rounded-lg">
            <button
              type="button"
              class="gallery-item block w-full rounded-lg focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-inset focus-visible:ring-main"
              data-full={image.full}
              data-title={image.title || ""}
              data-image-id={image.id}
              data-image-title={image.title}
              data-image-location={tagName || ""}
              data-dimensions={image.dimensions || ""}
              data-year={image.year?.toString() || ""}
              data-category={tagName || ""}
              data-etsy-url={image.etsyUrl || ""}
              data-insta-url={image.instagramUrl || ""}
            >
              <img
                src={image.src}
                srcset={image.srcset}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                alt={image.alt}
                width={image.width}
                height={image.height}
                class={`w-full h-auto rounded-lg shadow-card hover:shadow-card-hover transition-transform duration-300 group-hover:scale-105 ${transition("shadow")}`}
                loading={image.id === firstId ? "eager" : "lazy"}
                fetchpriority={image.id === firstId ? "high" : undefined}
                decoding="async"
              />
            </button>
            {/* Hover overlay with gradient and title */}
            <div
              class={`absolute inset-0 rounded-lg bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 ${transition("opacity")} flex flex-col justify-end pointer-events-none`}
            >
              <div class="p-4 text-white">
                {image.title && (
                  <h3 class="text-lg font-semibold leading-tight mb-1 drop-shadow-md">
                    {image.title}
                  </h3>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    ))
  }
</div>

<!-- image overlay / lightbox -->
<!-- need z index 50 to be above mobile and desktop sidebars -->
<div
  id="overlay-container"
  role="dialog"
  aria-modal="true"
  aria-label="Image viewer"
  class="fixed inset-0 flex justify-center items-center bg-gray-900/70 z-50 invisible opacity-0 backdrop-blur-lg"
>
  <!-- Close button -->
  <button
    id="lightbox-close"
    type="button"
    class="absolute top-4 right-4 z-50 w-12 h-12 sm:w-10 sm:h-10 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60 transition-colors text-white"
    aria-label="Close lightbox"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-7 h-7 sm:w-6 sm:h-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M6 18L18 6M6 6l12 12"></path>
    </svg>
  </button>

  <!-- Previous arrow -->
  <button
    id="lightbox-prev"
    type="button"
    class="absolute left-4 top-1/2 -translate-y-1/2 z-50 w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60 transition-colors text-white"
    aria-label="Previous image"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-7 h-7 sm:w-6 sm:h-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"
      ></path>
    </svg>
  </button>

  <!-- Next arrow -->
  <button
    id="lightbox-next"
    type="button"
    class="absolute right-4 top-1/2 -translate-y-1/2 z-50 w-10 h-10 sm:w-12 sm:h-12 flex items-center justify-center rounded-full bg-black/40 hover:bg-black/60 transition-colors text-white"
    aria-label="Next image"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="w-7 h-7 sm:w-6 sm:h-6"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"
      ></path>
    </svg>
  </button>

  <!-- Image counter -->
  <div
    id="lightbox-counter"
    class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white text-sm z-50"
  >
    <span id="counter-current">1</span> / <span id="counter-total">1</span>
  </div>

  <!-- Main lightbox content: image left, details right -->
  <div
    id="overlay-image-container"
    class="flex flex-col lg:flex-row max-w-[96%] lg:max-w-[85%] max-h-[90%] lg:max-h-[85%] mx-2 lg:mx-16"
  >
    <!-- Image section -->
    <div
      class="image-section relative flex-shrink-0 flex items-center justify-center lg:max-w-[65%]"
    >
      <div id="overlay-spinner" aria-hidden="true"></div>
      <img
        id="overlay-image"
        class="max-h-[72vh] max-w-full lg:max-h-[80vh] w-auto object-contain rounded-lg shadow-2xl"
      />
    </div>

    <!-- Details panel -->
    <div
      id="details-panel"
      class="bg-white rounded-lg p-3 lg:p-6 lg:ml-6 mt-2 lg:mt-0 lg:min-w-[280px] lg:max-w-[320px] flex flex-col overflow-y-auto max-h-[18vh] lg:max-h-[80vh]"
    >
      <!-- Title -->
      <h2 id="overlay-title" class="text-base lg:text-2xl text-gray-800 mb-1"></h2>

      <!-- Category/Collection -->
      <p id="overlay-category" class="text-gray-500 text-sm mb-1 lg:mb-4"></p>

      <!-- Metadata + social links, pinned to the bottom of the panel -->
      <div class="mt-auto">
      <div
        id="metadata-container"
        class="border-t border-gray-200 pt-2 lg:pt-4 space-y-3"
      >
        <div id="meta-dimensions" class="flex justify-between">
          <span class="text-gray-500 text-sm">Dimensions</span>
          <span
            id="overlay-dimensions"
            class="text-gray-800 text-sm font-medium"></span>
        </div>
        <div id="meta-year" class="flex justify-between">
          <span class="text-gray-500 text-sm">Year</span>
          <span id="overlay-year" class="text-gray-800 text-sm font-medium"
          ></span>
        </div>
      </div>

      <!-- Social links -->
      <div
        id="social-links-container"
        class="flex gap-3 mt-2 lg:mt-4 pt-2 lg:pt-4 border-t border-gray-200"
      >
        <a
          id="overlay-etsy"
          class="hidden"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View on Etsy"
        >
          <Etsy
            classList="fill-gray-600 hover:fill-main transition-colors"
            width={svgSize}
            height={svgSize}
          />
        </a>
        <a
          id="overlay-insta"
          class="hidden"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View on Instagram"
        >
          <Instagram
            classList="fill-gray-600 hover:fill-main transition-colors"
            width={svgSize}
            height={svgSize}
          />
        </a>
      </div>
      </div>
    </div>
  </div>
</div>

{/* PROTOTYPE — dev only, see src/components/prototype */}
{import.meta.env.DEV && <LightboxPrototype />}
