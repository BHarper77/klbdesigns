---
/**
 * PROTOTYPE — throwaway. Delete once a lightbox layout is picked.
 *
 * Question: what should the gallery lightbox look like?
 * Four variants of the lightbox on the existing gallery routes, switchable via
 * `?variant=A|B|C|D`. Dev only (mounted behind `import.meta.env.DEV` in
 * Gallery.astro). Restyles the real lightbox DOM via `data-variant`, so the
 * real open/close/swipe/keyboard logic stays in play.
 *
 *   A  Side card      current: image left, white details card right
 *   B  Caption        no card, white caption + link pills under the image
 *   C  Framed print   image in a white mount, centred placard beneath
 *   D  Docked panel   full-height side panel / mobile bottom sheet, big CTAs
 */
---

<div id="lb-proto-bar" aria-label="Prototype variant switcher">
  <button type="button" id="lb-proto-prev" aria-label="Previous variant">←</button>
  <span id="lb-proto-label"></span>
  <button type="button" id="lb-proto-next" aria-label="Next variant">→</button>
</div>

<script>
  (() => {
    const VARIANTS = [
      ["A", "Side card (current)"],
      ["B", "Caption"],
      ["C", "Framed print"],
      ["D", "Docked panel"],
    ] as const;

    const overlay = document.getElementById("overlay-container");
    const label = document.getElementById("lb-proto-label");
    if (!overlay || !label) return;

    // wrap each social icon with a text label; variants decide whether to show it
    const labels: Record<string, string> = {
      "overlay-etsy": "Buy on Etsy",
      "overlay-insta": "View on Instagram",
    };
    for (const [id, text] of Object.entries(labels)) {
      const a = document.getElementById(id);
      const svg = a?.querySelector("svg");
      if (!a || !svg) continue;
      const pill = document.createElement("span");
      pill.className = "lb-pill";
      const span = document.createElement("span");
      span.className = "lb-label";
      span.textContent = text;
      pill.append(svg, span);
      a.append(pill);
    }

    let index = Math.max(
      0,
      VARIANTS.findIndex(
        ([key]) =>
          key ===
          new URLSearchParams(location.search).get("variant")?.toUpperCase(),
      ),
    );

    function apply() {
      const [key, name] = VARIANTS[index]!;
      overlay!.dataset.variant = key;
      label!.textContent = `${key} — ${name}`;
      const url = new URL(location.href);
      url.searchParams.set("variant", key);
      history.replaceState(null, "", url);
    }

    function cycle(delta: number) {
      index = (index + delta + VARIANTS.length) % VARIANTS.length;
      apply();
    }

    document
      .getElementById("lb-proto-prev")
      ?.addEventListener("click", () => cycle(-1));
    document
      .getElementById("lb-proto-next")
      ?.addEventListener("click", () => cycle(1));

    // ←/→ already page through images in the lightbox, so use [ and ]
    document.addEventListener("keydown", (e) => {
      if (e.key === "[") cycle(-1);
      if (e.key === "]") cycle(1);
    });

    apply();
  })();
</script>

<style is:global>
  /* ---------- switcher bar (not part of the design) ---------- */
  #lb-proto-bar {
    position: fixed;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px;
    border-radius: 9999px;
    background: #facc15;
    color: #111;
    font:
      600 12px/1 ui-monospace,
      monospace;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
    white-space: nowrap;
  }
  #lb-proto-bar button {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    background: #111;
    color: #facc15;
  }
  #lb-proto-label {
    padding: 0 8px;
  }

  /* ---------- shared: link pill wrapper ---------- */
  .lb-pill {
    display: contents;
  }
  .lb-label {
    display: none;
  }
  #overlay-container:not([data-variant="A"]) .lb-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  #overlay-container:not([data-variant="A"]) .lb-label {
    display: inline;
  }
  #overlay-container:not([data-variant="A"]) .lb-pill svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  #overlay-container:not([data-variant="A"]) #social-links-container {
    border-top: 0;
    padding-top: 0;
    margin-top: 0;
  }

  /* =====================================================
     B — Caption: no card, text straight on the backdrop
     ===================================================== */
  [data-variant="B"] #overlay-image-container {
    flex-direction: column;
    align-items: stretch;
  }
  [data-variant="B"] .image-section {
    max-width: none;
  }
  [data-variant="B"] #overlay-image {
    max-height: 74vh;
  }
  [data-variant="B"] #details-panel {
    display: grid !important;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: 16px;
    background: transparent;
    padding: 12px 4px 0;
    margin: 0;
    min-width: 0;
    max-width: none;
    max-height: none;
    overflow: visible;
    border-radius: 0;
  }
  [data-variant="B"] #overlay-title {
    grid-column: 1;
    color: #fff;
    font-size: 1.125rem;
    line-height: 1.3;
    margin: 0;
  }
  [data-variant="B"] #overlay-category {
    grid-column: 1;
    color: #d1d5db;
    margin: 0;
  }
  [data-variant="B"] #details-panel > .mt-auto {
    grid-column: 2;
    grid-row: 1 / span 2;
    margin: 0;
  }
  [data-variant="B"] #metadata-container {
    display: none !important;
  }
  [data-variant="B"] .lb-pill {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.6);
  }
  [data-variant="B"] .lb-pill:hover {
    background: #fff;
    color: #3c3c3b;
  }
  @media (max-width: 639px) {
    /* icon-only pills on phones so the title keeps its room */
    [data-variant="B"] .lb-label {
      display: none !important;
    }
    [data-variant="B"] .lb-pill {
      padding: 10px;
    }
    [data-variant="B"] #overlay-image {
      max-height: 70vh;
    }
  }

  /* =====================================================
     C — Framed print: white mount, centred placard
     ===================================================== */
  [data-variant="C"] #overlay-image-container {
    flex-direction: column;
    align-items: stretch;
    background: #fff;
    padding: 12px 12px 0;
    border-radius: 6px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
  }
  [data-variant="C"] .image-section {
    max-width: none;
  }
  [data-variant="C"] #overlay-image {
    max-height: 66vh;
    border-radius: 2px;
    box-shadow: none;
  }
  [data-variant="C"] #details-panel {
    align-items: center;
    text-align: center;
    padding: 14px 8px 16px;
    margin: 0;
    min-width: 0;
    max-width: none;
    max-height: none;
    overflow: visible;
    border-radius: 0;
  }
  [data-variant="C"] #overlay-title {
    font-size: 1.125rem;
    line-height: 1.3;
    color: #3c3c3b;
    margin: 0;
  }
  [data-variant="C"] #overlay-category {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #6b7280;
    margin: 4px 0 0;
  }
  [data-variant="C"] #details-panel > .mt-auto {
    margin-top: 10px;
  }
  [data-variant="C"] #metadata-container {
    display: none !important;
  }
  [data-variant="C"] #social-links-container {
    justify-content: center;
    gap: 4px;
  }
  [data-variant="C"] .lb-pill {
    color: #4a8a81;
    padding: 6px 10px;
  }
  [data-variant="C"] .lb-pill:hover {
    background: #f3f4f6;
  }
  [data-variant="C"] .lb-label {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 1024px) {
    [data-variant="C"] #overlay-image-container {
      padding: 20px 20px 0;
    }
    [data-variant="C"] #overlay-image {
      max-height: 68vh;
    }
  }

  /* =====================================================
     D — Docked panel: side panel on desktop, bottom sheet on mobile
     ===================================================== */
  [data-variant="D"] #overlay-image-container {
    position: fixed;
    inset: 0;
    max-width: none;
    max-height: none;
    margin: 0;
    flex-direction: column;
    /* let clicks on the empty backdrop fall through and close */
    pointer-events: none;
  }
  [data-variant="D"] #overlay-image,
  [data-variant="D"] #details-panel {
    pointer-events: auto;
  }
  [data-variant="D"] .image-section {
    flex: 1 1 0;
    min-height: 0;
    max-width: none;
    padding: 64px 8px 12px;
  }
  [data-variant="D"] #overlay-image {
    max-height: calc(100vh - 250px);
    max-height: calc(100dvh - 250px);
  }
  [data-variant="D"] #details-panel {
    flex: 0 0 auto;
    margin: 0;
    padding: 18px 20px 20px;
    min-width: 0;
    max-width: none;
    max-height: none;
    overflow: visible;
    border-radius: 16px 16px 0 0;
    box-shadow: 0 -8px 30px rgba(0, 0, 0, 0.25);
  }
  [data-variant="D"] #overlay-title {
    font-size: 1.125rem;
    line-height: 1.3;
    color: #3c3c3b;
    margin: 0;
  }
  [data-variant="D"] #overlay-category {
    margin: 2px 0 0;
  }
  [data-variant="D"] #details-panel > .mt-auto {
    margin-top: 14px;
  }
  [data-variant="D"] #social-links-container {
    gap: 8px;
  }
  [data-variant="D"] #social-links-container a {
    flex: 1 1 0;
  }
  [data-variant="D"] .lb-pill {
    display: flex;
    width: 100%;
    padding: 12px 10px;
    border-radius: 8px;
    white-space: nowrap;
  }
  [data-variant="D"] #overlay-etsy .lb-pill {
    background: #5da399;
    color: #fff;
  }
  [data-variant="D"] #overlay-etsy .lb-pill:hover {
    background: #4a8a81;
  }
  [data-variant="D"] #overlay-insta .lb-pill {
    color: #3c3c3b;
    border: 1px solid #d1d5db;
  }
  [data-variant="D"] #overlay-insta .lb-pill:hover {
    background: #f3f4f6;
  }
  [data-variant="D"] #lightbox-counter {
    top: 26px;
    bottom: auto;
    left: 16px;
    transform: none;
  }
  @media (max-width: 1023px) {
    /* keep arrows over the image, not the sheet */
    [data-variant="D"] #lightbox-prev,
    [data-variant="D"] #lightbox-next {
      top: calc(50% - 60px);
    }
  }
  @media (min-width: 1024px) {
    [data-variant="D"] #overlay-image-container {
      flex-direction: row;
    }
    [data-variant="D"] .image-section {
      padding: 40px 80px 64px;
    }
    [data-variant="D"] #overlay-image {
      max-height: calc(100vh - 104px);
    }
    [data-variant="D"] #details-panel {
      flex: 0 0 360px;
      height: 100%;
      padding: 72px 32px 32px;
      border-radius: 0;
      box-shadow: -8px 0 30px rgba(0, 0, 0, 0.25);
    }
    [data-variant="D"] #overlay-title {
      font-size: 1.75rem;
    }
    [data-variant="D"] #overlay-category {
      margin-top: 6px;
    }
    [data-variant="D"] #details-panel > .mt-auto {
      margin-top: auto;
    }
    [data-variant="D"] #social-links-container {
      flex-direction: column;
    }
    [data-variant="D"] #lightbox-next {
      right: calc(360px + 1rem);
    }
    [data-variant="D"] #lightbox-close {
      background: transparent;
      color: #3c3c3b;
    }
    [data-variant="D"] #lightbox-close:hover {
      background: #f3f4f6;
    }
    [data-variant="D"] #lightbox-counter {
      top: auto;
      bottom: 24px;
      left: calc((100% - 360px) / 2);
      transform: translateX(-50%);
    }
  }
</style>
