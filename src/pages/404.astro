---
import Layout from "../layouts/Layout.astro"
---

<style>
  @media (min-width: 640px) {
    .content-wrapper {
      margin-left: 16rem; /* 256px = sidebar width */
    }
  }
</style>

<Layout title="Page not found - k.l.b designs">
  <div class="content-wrapper p-5 sm:p-12 max-w-2xl">
    <h1 class="text-xl sm:text-4xl text-secondary mb-6">Page not found</h1>
    <p class="text-gray-700 leading-relaxed mb-6">
      Sorry, that page doesn't exist or has moved.
    </p>
    <a
      href="/"
      class="inline-block px-4 py-2 rounded-lg bg-main text-white hover:bg-secondary transition-colors duration-200"
      >Back to gallery</a
    >
  </div>
</Layout>
